<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingStart="18dp"
    android:paddingTop="32dp"
    android:paddingEnd="18dp"
    android:paddingBottom="32dp">

    <!-- Floating iOS Modal Sheet Card (Non-Fullscreen Launch) -->
    <LinearLayout
        android:id="@+id/iosSheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ios_sheet"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- iOS Sheet Grabber Handle -->
        <View
            android:layout_width="38dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_ios_grabber" />

        <!-- iOS Navigation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ios_label_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/ios_label_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCloseSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="@string/btn_done"
                android:textColor="@color/ios_blue"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ios_separator" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <!-- SECTION 1: OVERLAY CONTROL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/section_service_control"
                    android:textColor="@color/ios_label_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvServiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/service_status_stopped"
                        android:textColor="@color/ios_label_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnToggleOverlayService"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/ios_blue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_start_edge_overlay"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- SECTION 2: OVERLAY APPEARANCE EDITOR -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/section_overlay_editor"
                    android:textColor="@color/ios_label_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Lock Icon Size Slider (10dp - 28dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_icon_size_label"
                            android:textColor="@color/ios_label_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvIconSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14 dp"
                            android:textColor="@color/ios_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekIconSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="18"
                        android:progress="4"
                        android:progressTint="@color/ios_blue"
                        android:thumbTint="@color/ios_blue" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/ios_separator" />

                    <!-- Overlay Opacity / Transparency Slider (15% - 100%) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_opacity_label"
                            android:textColor="@color/ios_label_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvOpacityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45%"
                            android:textColor="@color/ios_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="85"
                        android:progress="30"
                        android:progressTint="@color/ios_blue"
                        android:thumbTint="@color/ios_blue" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/ios_separator" />

                    <!-- Corner Radius Slider (4dp - 24dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_corner_radius_label"
                            android:textColor="@color/ios_label_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCornerRadiusValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 dp"
                            android:textColor="@color/ios_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekCornerRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="20"
                        android:progress="8"
                        android:progressTint="@color/ios_blue"
                        android:thumbTint="@color/ios_blue" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/ios_separator" />

                    <!-- Show Status Dot Toggle -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowStatusDot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_show_dot_label"
                        android:textColor="@color/ios_label_primary"
                        android:textSize="14sp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/ios_green" />

                    <!-- Reset Appearance Button -->
                    <Button
                        android:id="@+id/btnResetAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/ios_fill_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_reset_appearance"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- SECTION 3: BEHAVIOR & USB-C MOUSE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/section_edge_settings"
                    android:textColor="@color/ios_label_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDoubleTapUnlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_double_tap_unlock"
                        android:textColor="@color/ios_label_primary"
                        android:textSize="14sp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/ios_green" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/ios_separator" />

                    <!-- USB-C Mouse Pass-Through Aperture Slider (24dp - 80dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editor_mouse_aperture_label"
                            android:textColor="@color/ios_label_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMouseApertureValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="44 dp"
                            android:textColor="@color/ios_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekMouseAperture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="56"
                        android:progress="20"
                        android:progressTint="@color/ios_blue"
                        android:thumbTint="@color/ios_blue" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/ios_separator" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_edge_side_label"
                        android:textColor="@color/ios_label_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/radioGroupEdgeSide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioEdgeLeft"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/ios_blue"
                            android:text="@string/edge_side_left"
                            android:textColor="@color/ios_label_primary"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radioEdgeRight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/ios_blue"
                            android:checked="true"
                            android:text="@string/edge_side_right"
                            android:textColor="@color/ios_label_primary"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- SECTION 4: PERMISSIONS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/section_overlay_permission"
                    android:textColor="@color/ios_label_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvPermissionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_status_missing"
                        android:textColor="@color/ios_label_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGrantOverlayPermission"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/ios_blue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_grant_permission"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/restricted_settings_help"
                        android:textColor="@color/ios_label_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnOpenAppInfo"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/ios_fill_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_open_app_info"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_label_primary"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
